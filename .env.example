# Copy to .env and fill in the empty values; .env is never committed (ADR-004).

# Uncomment for the production images (VPS, end-to-end tests); without it, development.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

# The db superuser's password, used when the db volume is created. Empty on purpose, so the
# stack refuses to start until you set one; URL-safe, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# development or production (ADR-004). Read by the development stack only:
# compose.prod.yaml fixes TOURNEYHUB_ENV=production.
TOURNEYHUB_ENV=development
# The db service on the Compose network, with the password above.
TOURNEYHUB_DATABASE_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@db:5432/tourneyhub
# HS256 key of at least 32 bytes. Empty on purpose, so the stack refuses to
# start until you set one, e.g. `openssl rand -hex 24`.
TOURNEYHUB_JWT_SECRET=
# The refresh cookie's Secure flag; false only with TOURNEYHUB_ENV=development
# (ADR-004). Read by the development stack only: compose.prod.yaml fixes
# TOURNEYHUB_COOKIE_SECURE=true.
TOURNEYHUB_COOKIE_SECURE=false

# Host ports of Caddy in the production stack; change them when 80 or 443 is taken.
HTTP_PORT=80
HTTPS_PORT=443
# Caddy's site address: localhost locally (its internal CA), the domain on the VPS.
SITE_ADDRESS=localhost
