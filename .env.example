# TourneyHub — environment configuration reference
# Copy to `.env` and adjust. NEVER commit a real `.env` (see .gitignore).
# Keys use ASP.NET Core's double-underscore convention (Section__Key) so they
# bind directly to IConfiguration. Docker Compose reads POSTGRES_* for the DB container.

# ---- App host ----
ASPNETCORE_ENVIRONMENT=Development
# Kestrel bind address; the frontend expects the API at http://localhost:8080/api/v1
ASPNETCORE_URLS=http://localhost:8080

# ---- Database (PostgreSQL) ----
# Used by the API (EF Core / Npgsql).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=tourneyhub;Username=tourneyhub;Password=tourneyhub
# Consumed by the postgres container in docker-compose.yml.
POSTGRES_USER=tourneyhub
POSTGRES_PASSWORD=tourneyhub
POSTGRES_DB=tourneyhub

# ---- Redis (cache + SignalR backplane, NFR-007) ----
ConnectionStrings__Redis=localhost:6379

# ---- Auth / JWT (NFR-009) ----
Jwt__Issuer=tourneyhub
Jwt__Audience=tourneyhub
# MUST be >= 32 bytes in production; never log or commit the real value.
Jwt__SigningKey=dev-only-change-me-please-32-bytes-minimum-secret

# ---- Email: self-host SMTP (dev = Mailpit) — FR-142, secondary path ----
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__Username=
Email__Password=
Email__SenderAddress=no-reply@tourneyhub.local
Email__SenderName=TourneyHub

# ---- Email: hosted managed provider (primary in hosted; blank for self-host) — Q-010, NFR-025 ----
# e.g. Email__Provider=postmark|sendgrid|ses ; Email__ApiKey=...
Email__Provider=smtp
Email__ApiKey=

# ---- Instance admin bootstrap (self-host) — FR-009a..d, Q-011 ----
TOURNEYHUB_ADMIN_EMAIL=admin@tourneyhub.local
# Optional one-time bootstrap token; blank disables token-based elevation.
TOURNEYHUB_ADMIN_BOOTSTRAP_TOKEN=
# Opt-in ONLY: allow first-registered user to become admin on an empty instance.
TOURNEYHUB_ALLOW_FIRST_USER_ADMIN=false

# ---- Frontend (Vite) — see web/.env.example ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
