# TourneyHub — environment configuration reference (pydantic-settings, prefix TOURNEYHUB_).
# Copy to `.env` and adjust. NEVER commit a real `.env`. Secrets are env-only (NFR-021).

# ---- App ----
TOURNEYHUB_ENV=development                     # development | test | production
TOURNEYHUB_API_HOST=0.0.0.0
TOURNEYHUB_API_PORT=8000
TOURNEYHUB_PUBLIC_BASE_URL=http://localhost:5173   # used in emails / OpenGraph links
TOURNEYHUB_CORS_ORIGINS=["http://localhost:5173"]
TOURNEYHUB_LOG_LEVEL=INFO
TOURNEYHUB_MODULES=all                         # or comma list: platform,identity,invitations,leagues,tournaments,finance,realtime

# ---- Database (PostgreSQL, ADR-006 roles) ----
TOURNEYHUB_DATABASE_URL=postgresql+asyncpg://tourneyhub:tourneyhub@localhost:5432/tourneyhub
# Privileged role used ONLY by migrations, admin listings and the retention job (BYPASSRLS).
TOURNEYHUB_DATABASE_ADMIN_URL=postgresql+asyncpg://tourneyhub:tourneyhub@localhost:5432/tourneyhub
# Consumed by the postgres container in docker-compose.yml.
POSTGRES_USER=tourneyhub
POSTGRES_PASSWORD=tourneyhub
POSTGRES_DB=tourneyhub

# ---- Redis (SSE fan-out, rate limits, cache) ----
TOURNEYHUB_REDIS_URL=redis://localhost:6379/0

# ---- Auth (ADR-008) ----
TOURNEYHUB_JWT_SECRET=dev-only-change-me-please-32-bytes-minimum-secret   # >= 32 bytes in production
TOURNEYHUB_JWT_ISSUER=tourneyhub
TOURNEYHUB_ACCESS_TOKEN_TTL_SECONDS=900
TOURNEYHUB_REFRESH_TOKEN_TTL_DAYS=30
TOURNEYHUB_HIBP_CHECK_ENABLED=true

# ---- Email (FR-142): provider = smtp | resend | postmark | ses ----
TOURNEYHUB_EMAIL_PROVIDER=smtp
TOURNEYHUB_EMAIL_FROM_ADDRESS=no-reply@tourneyhub.local
TOURNEYHUB_EMAIL_FROM_NAME=TourneyHub
TOURNEYHUB_EMAIL_SMTP_HOST=localhost                # dev = Mailpit
TOURNEYHUB_EMAIL_SMTP_PORT=1025
TOURNEYHUB_EMAIL_SMTP_USERNAME=
TOURNEYHUB_EMAIL_SMTP_PASSWORD=
TOURNEYHUB_EMAIL_SMTP_STARTTLS=false
TOURNEYHUB_EMAIL_API_KEY=                           # managed provider (hosted)

# ---- Self-host bootstrap (FR-009a..d) ----
TOURNEYHUB_ADMIN_EMAIL=admin@tourneyhub.local
TOURNEYHUB_ADMIN_BOOTSTRAP_TOKEN=                   # optional one-time token
TOURNEYHUB_ALLOW_FIRST_USER_ADMIN=false             # opt-in only, empty instance only
TOURNEYHUB_DEFAULT_ORG_NAME=My Organization
TOURNEYHUB_DEFAULT_ORG_SLUG=default

# ---- Policies ----
TOURNEYHUB_PRIVACY_POLICY_VERSION=2026-09-24
TOURNEYHUB_TERMS_VERSION=2026-09-24
TOURNEYHUB_AUDIT_PII_RETENTION_DAYS=365
TOURNEYHUB_DELETED_ACCOUNT_PURGE_DAYS=30

# ---- Frontend (Vite) — see web/.env.example once scaffolded ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
