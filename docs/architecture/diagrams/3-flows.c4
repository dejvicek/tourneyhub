// Dynamic views: the flows the reviews spent most time on, and the PRD §5.1 evening.
// All flows except release open as a sequence diagram; the Diagram/Sequence switch stays in the toolbar.
// Long flows are split in two (13a/13b, 15a/15b) and the halves are linked with navigateTo.
// The string after `views` is the folder (III. Flows) shown before the title; `order` fixes the position in lists.
views "III. Flows" {

  dynamic view loginRefresh {
    variant sequence
    title "9. Login and token refresh"
    order 9
    description "ADR-006: access JWT (HS256) valid 15 minutes, kept in memory, refused at once when its refresh-token family is revoked (401 token_expired, so the SPA refreshes once and logs out); refresh token in an HttpOnly, SameSite=Strict cookie on /api/v1/auth, with rotation and a 60-second window."
    organizer -> tourneyhub.spa.organizerUi "logs in with email and password"
    tourneyhub.spa.organizerUi -> tourneyhub.spa.authClient "login"
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "POST /api/v1/auth/login"
    tourneyhub.api.authApi -> tourneyhub.db.accounts "counts the attempt per email and per IP (IPv6 per /64) before the password check, in a transaction of its own"
    alt {
      when "inside the waiting period after repeated failures" {
        tourneyhub.spa.authClient <- tourneyhub.api.authApi "429 too_many_attempts with Retry-After; password not checked" {
          notes "Nothing sleeps on the server and the account is never locked (ADR-006)."
        }
      }
      when "otherwise" {
        tourneyhub.api.authApi -> tourneyhub.db.accounts "verifies Argon2id (a dummy hash for an unknown email); on success marks the attempt succeeded and stores the hash of the new refresh token"
        tourneyhub.spa.authClient <- tourneyhub.api.authApi "access JWT in the body + HttpOnly cookie, or 401"
      }
    }
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "on page load or after 401: POST /api/v1/auth/refresh with X-Requested-With"
    tourneyhub.api.authApi -> tourneyhub.db.accounts "locks the token family (FOR UPDATE), then reads it"
    alt {
      when "token not yet rotated, or rotated less than 60 s ago" {
        tourneyhub.spa.authClient <- tourneyhub.api.authApi "new access JWT and cookie"
      }
      when "token revoked or expired" {
        tourneyhub.spa.authClient <- tourneyhub.api.authApi "401: log in again; nothing changes"
      }
      when "token rotated 60 s ago or earlier (reuse)" {
        tourneyhub.api.authApi -> tourneyhub.db.accounts "revokes the whole family under the same locks" {
          notes "The endpoint returns the 401 instead of raising, so the revocation commits (ADR-001)."
        }
        tourneyhub.spa.authClient <- tourneyhub.api.authApi "401: log in again"
      }
    }
    organizer -> tourneyhub.spa.organizerUi "logs out"
    tourneyhub.spa.organizerUi -> tourneyhub.spa.authClient "logout"
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "POST /api/v1/auth/logout with X-Requested-With"
    tourneyhub.api.authApi -> tourneyhub.db.accounts "revokes the cookie's family"
    tourneyhub.spa.authClient <- tourneyhub.api.authApi "204, cookie removed; other devices stay logged in"
  }

  dynamic view signUp {
    variant sequence
    title "9b. Sign-up"
    order 10
    description "FR-001, ADR-006 and ADR-007: an account needs the instance's sign-up code. Wrong code and closed sign-up look the same. Success logs in as a login does."
    organizer -> tourneyhub.spa.organizerUi "enters email, name, password and the code from the admin"
    tourneyhub.spa.organizerUi -> tourneyhub.spa.authClient "sign-up"
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "POST /api/v1/auth/signup"
    tourneyhub.api.authApi -> tourneyhub.db.accounts "counts the attempt per IP (IPv6 per /64) before the code check, in a transaction of its own"
    alt {
      when "inside the waiting period after repeated failures" {
        tourneyhub.spa.authClient <- tourneyhub.api.authApi "429 too_many_attempts with Retry-After; code not checked"
      }
      when "otherwise" {
        tourneyhub.api.authApi -> tourneyhub.db.accounts "compares the code from instance_settings in constant time; NULL means closed"
        alt {
          when "wrong code, or sign-up closed" {
            tourneyhub.spa.authClient <- tourneyhub.api.authApi "422 invalid_signup_code"
          }
          when "email already has an account (any letter case)" {
            tourneyhub.spa.authClient <- tourneyhub.api.authApi "422 email_taken"
          }
          when "otherwise" {
            tourneyhub.api.authApi -> tourneyhub.db.accounts "stores the user, marks the attempt succeeded, stores the hash of a new refresh token"
            tourneyhub.spa.authClient <- tourneyhub.api.authApi "201: access JWT in the body + HttpOnly cookie"
          }
        }
      }
    }
  }

  dynamic view passwordChange {
    variant sequence
    title "9c. Password change"
    order 11
    description "FR-004 and ADR-006: needs the current password. It also ends a required change after an admin reset. This device stays logged in; the others are logged out."
    organizer -> tourneyhub.spa.organizerUi "enters the current and a new password"
    tourneyhub.spa.organizerUi -> tourneyhub.spa.authClient "change password"
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "POST /api/v1/auth/password (Bearer JWT)"
    tourneyhub.api.authApi -> tourneyhub.db.accounts "counts the attempt on the login's budget (email, IP), in a transaction of its own"
    alt {
      when "inside the waiting period after repeated failures" {
        tourneyhub.spa.authClient <- tourneyhub.api.authApi "429 too_many_attempts with Retry-After; password not checked"
      }
      when "otherwise" {
        tourneyhub.api.authApi -> tourneyhub.db.accounts "locks the user row and verifies the current password"
        alt {
          when "current password wrong, or new one equal to it" {
            tourneyhub.spa.authClient <- tourneyhub.api.authApi "422 wrong_password or password_unchanged; nothing changes"
          }
          when "otherwise" {
            tourneyhub.api.authApi -> tourneyhub.db.accounts "new hash, clears must_change_password, revokes the other families, marks the attempt succeeded"
            tourneyhub.spa.authClient <- tourneyhub.api.authApi "204; other devices are logged out"
          }
        }
      }
    }
  }

  dynamic view resultEntry {
    variant sequence
    title "10. Result entry"
    order 12
    description "FR-050 to FR-053, FR-082, FR-094, BR-090 to BR-095, BR-121, BR-130 to BR-134 and ADR-008: at most three taps plus the score. The result is sent whole, every game or the walkover, as the target state; the empty result clears it. The write locks the league, then the tournament. The engine checks the games against the match's format and the draw rule; a saved result frees the field, which takes the next waiting match. Standings are not computed on write; they are computed on every read (ADR-009)."
    organizer -> tourneyhub.spa.organizerUi "opens the match, chooses the result, saves"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/matches/{id}/result: the games, a walkover or nothing (Bearer JWT)"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "SELECT … FOR UPDATE on the league; a closed season: 409"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "SELECT … FOR UPDATE on the tournament, with its rounds and fields"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "finds the match: another tournament's is 404; sides not known: 422"
    alt {
      when "games or a walkover" {
        tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "outcome from the games: format, draws, scores; else 422 with the rule's code"
        tourneyhub.api.tournamentsApi -> tourneyhub.db.play "games, outcome and result time (an equal repeat changes nothing)"
        tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "the freed field takes the first waiting match whose players are free"
        tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "fields hold their new matches"
      }
      when "the empty result" {
        tourneyhub.api.tournamentsApi -> tourneyhub.db.play "deletes the games; the match waits and takes no field by itself"
        tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "a finished tournament is in progress again"
      }
    }
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the match"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "reloads the tournament and GET …/play" {
      navigateTo roundRobinFinish
    }
  }

  dynamic view addRound {
    variant sequence
    title "11. Next round in a Swiss"
    order 13
    description "ADR-011: BR-056 top-down; when it gets stuck, blossom matching on pairs that have not met. Round 1 comes with the start, from the seeds (BR-055, BR-058). A round can be added once every match in the newest round has a result (FR-040); the rounds before it lock (BR-065). Deleting the newest round unlocks the one before (BR-066); deleting round 1 goes back to setup (FR-046). The standings and their tie-breakers are computed on read (ADR-009), so the order of the tie-breakers can change while the tournament runs (FR-043)."
    organizer -> tourneyhub.spa.organizerUi "add a round"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST …/rounds with the expected round_no"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "locks the league"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the tournament: not a Swiss or a knockout drawn 422"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "checks round_no (otherwise 409 round_number_changed) and the newest round's results (422 round_not_complete), loads matches and participation"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "standings, sit-out (BR-058), BR-056 pairing, fallback matching if needed; disabled entries left out (BR-064)"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "stores the round, matches and round_participation (disabled for a disabled entry); free fields take its matches"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "201: the new round"
    opt "the organizer deletes the newest round" {
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "DELETE …/rounds/{round_id}; a repeat 404, an older round 409 round_not_newest"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.play "frees its fields, deletes the round with its matches and participation; round 1: back to setup"
      tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "204"
    }
    opt "the organizer disables or re-enables an entry (FR-044)" {
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/entries/{entry_id}/disabled with the target state"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league and the tournament: not in progress 409, not a Swiss or Monster DYP group phase or a Lord have mercy knockout 422; sets entries.is_disabled, a repeat changes nothing"
      tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the participant; the next round leaves a disabled entry out (BR-064)"
    }
    opt "the organizer reorders the tie-breakers" {
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/tiebreakers with the enabled ones in order"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "stores the phase's tiebreakers; a finished tournament 409, a knockout drawn 422"
      tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the tournament; GET …/play shows the new order"
    }
  }

  dynamic view shareLink {
    variant sequence
    title "12. Viewer through the share link"
    order 14
    description "FR-070 to FR-072: no account, read-only. The league, a season's tournaments and a tournament (P11); the season standings, a round robin's or a Swiss's standings and the places (P10a, P12) and the bracket (P10b), computed on every read (ADR-009). Every answer carries Cache-Control: no-store and Referrer-Policy: no-referrer, and the api logs the path as /public/***."
    viewer -> tourneyhub.spa.publicUi "opens the link from the organizer"
    tourneyhub.spa.publicUi -> tourneyhub.api.publicApi "GET /api/v1/public/{share_token}, …/seasons/{season_id}/tournaments, …/seasons/{season_id}/standings, …/tournaments/{tournament_id}, …/tournaments/{tournament_id}/standings, …/tournaments/{tournament_id}/places, …/tournaments/{tournament_id}/bracket, …/tournaments/{tournament_id}/knockout/rounds"
    tourneyhub.api.publicApi -> tourneyhub.db.leagues "finds the league by share token: one lookup on the unique index"
    opt "an unknown token" {
      tourneyhub.spa.publicUi <- tourneyhub.api.publicApi "404 share_link_not_found, empty detail, on every route"
    }
    tourneyhub.api.publicApi -> tourneyhub.db.tournaments "tournaments past setup; one in setup is 404 tournament_not_found"
    tourneyhub.api.publicApi -> tourneyhub.db.play "rounds, results and fields"
    tourneyhub.api.publicApi -> tourneyhub.api.engine "waiting order, standings, places and season points"
    tourneyhub.spa.publicUi <- tourneyhub.api.publicApi "league, season standings, schedule, fields, waiting matches, standings and places"
  }

  dynamic view adminReset {
    variant sequence
    title "13a. Forgotten password: admin reset"
    order 15
    description "FR-006, ADR-006 and ADR-007: the admin confirms, then gives the organizer a temporary password, chosen or generated with secrets and shown once. The reset sets must_change_password and revokes all of the organizer's logins, so old refresh tokens get 401. The access tokens of those logins stop at once: each request checks that the token's family still has an unrevoked row. An admin cannot reset their own account or another admin's (422 own_account, admin_target); admins are handled with the CLI. Continues in view 13b."
    admin -> tourneyhub.spa.adminUi "confirms the reset and chooses a temporary password, or has one generated"
    tourneyhub.spa.adminUi -> tourneyhub.api.adminApi "POST /api/v1/admin/organizers/{id}/password-reset (Bearer JWT, is_admin from the database)"
    tourneyhub.api.adminApi -> tourneyhub.db.accounts "new password hash, must_change_password, revokes all refresh token families, records reset_password with source web, the admin and the target in admin_actions"
    tourneyhub.spa.adminUi <- tourneyhub.api.adminApi "200 with the generated password (not stored, not cached); the admin hands it to the organizer"
    opt "the organizer still has the app open" {
      tourneyhub.spa.authClient -> tourneyhub.api.authApi "on page load or after 401: POST /api/v1/auth/refresh with the old token"
      tourneyhub.api.authApi -> tourneyhub.db.accounts "token is revoked, nothing changes"
      tourneyhub.spa.authClient <- tourneyhub.api.authApi "401: log in again" {
        navigateTo adminResetLogin
      }
    }
  }

  dynamic view adminResetLogin {
    variant sequence
    title "13b. Forgotten password: first login"
    order 16
    description "ADR-006: login with the password from the admin succeeds, but everything except /api/v1/auth/* and GET /api/v1/me returns 403 password_change_required until the organizer changes the password. The admin therefore knows the password only until then. Follows view 13a."
    organizer -> tourneyhub.spa.organizerUi "logs in with the password from the admin"
    tourneyhub.spa.organizerUi -> tourneyhub.spa.authClient "login"
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "POST /api/v1/auth/login" {
      navigateTo loginRefresh
    }
    tourneyhub.api.authApi -> tourneyhub.db.accounts "verifies Argon2id, stores the hash of the new refresh token"
    tourneyhub.spa.authClient <- tourneyhub.api.authApi "200: access JWT and cookie, login succeeds"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "GET leagues (Bearer JWT)"
    tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "403 password_change_required" {
      notes "must_change_password is read from the users row on every request (ADR-006)."
    }
    tourneyhub.spa.organizerUi -> tourneyhub.spa.authClient "opens the new-password screen; any other organizer or admin screen goes back to it, and a 403 password_change_required reads the account again"
    organizer -> tourneyhub.spa.organizerUi "enters a new password"
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "POST /api/v1/auth/password (FR-004)" {
      navigateTo passwordChange
    }
    tourneyhub.api.authApi -> tourneyhub.db.accounts "new hash, clears must_change_password, revokes the other families"
    tourneyhub.spa.authClient <- tourneyhub.api.authApi "done; other devices are logged out"
  }

  dynamic view adminSignupCode {
    variant sequence
    title "13c. Admin: sign-up code"
    order 17
    description "FR-005 and ADR-007: the admin sees, sets, generates or clears the sign-up code. Changing it does not affect existing accounts. Every change is recorded in admin_actions as set_signup_code, without the code; the CLI command set-signup-code records the same action with source cli."
    admin -> tourneyhub.spa.adminUi "opens the admin screen"
    tourneyhub.spa.adminUi -> tourneyhub.api.adminApi "GET /api/v1/admin/signup-code (Bearer JWT, is_admin from the database)"
    tourneyhub.api.adminApi -> tourneyhub.db.accounts "reads instance_settings"
    tourneyhub.spa.adminUi <- tourneyhub.api.adminApi "the code, or null while sign-up is closed (Cache-Control: no-store)"
    admin -> tourneyhub.spa.adminUi "types a code, generates one or closes sign-up"
    tourneyhub.spa.adminUi -> tourneyhub.api.adminApi "PUT /api/v1/admin/signup-code, or POST /api/v1/admin/signup-code/generate"
    tourneyhub.api.adminApi -> tourneyhub.db.accounts "updates instance_settings, records set_signup_code with source web and the admin in admin_actions"
    tourneyhub.spa.adminUi <- tourneyhub.api.adminApi "the new state"
  }

  dynamic view release {
    title "14. From PR to VPS"
    order 18
    description "ADR-012 and ADR-014: the VPS runs exactly the images that passed the tests. CI holds no SSH key to the VPS; the admin triggers the update."
    developer -> github.repo "merges the PR after review with passing checks"
    github.repo -> github.actions "push to main"
    github.actions -> github.ghcr "api and web images, only if Playwright passes"
    admin -> github.ghcr "on the VPS: docker compose pull"
    admin -> tourneyhub.api "on the VPS: docker compose up -d"
    tourneyhub.api -> tourneyhub.db "tourneyhub migrate (Alembic) on start"
  }

  dynamic view dypEvening {
    variant sequence
    title "15a. DYP evening: setup (PRD §5.1)"
    order 19
    description "PRD §5.1, steps 1 to 5: sign-up with the code from the admin, the league Thursday Foosball and its players, a DYP tournament for 12 players with a round robin, and the generated schedule. Continues in view 15b."
    organizer -> tourneyhub.spa.organizerUi "signs up with the code from the admin"
    tourneyhub.spa.organizerUi -> tourneyhub.spa.authClient "sign-up"
    tourneyhub.spa.authClient -> tourneyhub.api.authApi "POST sign-up with the sign-up code (FR-001)" {
      navigateTo signUp
    }
    organizer -> tourneyhub.spa.organizerUi "creates the league Thursday Foosball and adds players"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "league (Season 1 starts automatically), players"
    organizer -> tourneyhub.spa.organizerUi "on Thursday: DYP tournament with a round robin, 12 players"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "setup: halves by league ranking, partner draw" {
      navigateTo tournamentSetup
    }
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "league ranking and partner draw from the tournament's seed"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "generate the schedule" {
      navigateTo tournamentStart
    }
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "round robin: 6 pairs, 5 rounds, 15 matches"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "schedule stored, tournament in progress" {
      navigateTo dypEveningPlay
    }
  }

  dynamic view dypEveningPlay {
    variant sequence
    title "15b. DYP evening: play and viewers (PRD §5.1)"
    order 20
    description "PRD §5.1, steps 6 to 8: results during the evening, a knockout for the top 4 pairs without a third-place match, the final and season points, a viewer through the share link. Follows view 15a."
    loop "15 round-robin matches, as they finish" {
      organizer -> tourneyhub.spa.organizerUi "enters the result on the phone"
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "saves the result" {
        navigateTo resultEntry
      }
    }
    organizer -> tourneyhub.spa.organizerUi "a third table frees up: adds Field 3, moves matches by hand"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "adds a field, places matches" {
      navigateTo fieldsDuringPlay
    }
    organizer -> tourneyhub.spa.organizerUi "after the round robin: knockout for the top 4 pairs, no third-place match"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "start the knockout"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "bracket 1st v 4th and 2nd v 3rd, progression derived by itself"
    organizer -> tourneyhub.spa.organizerUi "enters the semifinals and the final"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "final's result, tournament finishes"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "places and season points per player: 10, 8, 5, 2, 0"
    viewer -> tourneyhub.spa.publicUi "opens the league's share link"
    tourneyhub.spa.publicUi -> tourneyhub.api.publicApi "GET by share token" {
      navigateTo shareLink
    }
    tourneyhub.api.publicApi -> tourneyhub.api.engine "round robin, bracket and season standings"
  }

  dynamic view leagueSeasons {
    variant sequence
    title "16. League and seasons"
    order 21
    description "FR-010, FR-011, FR-021 and ADR-008: a league comes with Season 1. The placement points table lives on the season. A new season carries the current season's number, so a repeat or a second device gets 409."
    organizer -> tourneyhub.spa.organizerUi "creates a league"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "POST league with a client id"
    tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "league, share token, Season 1: one transaction"
    tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "league with Season 1"
    organizer -> tourneyhub.spa.organizerUi "changes the placement points"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "PUT the active season's table"
    tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "locks the league; a closed season: 409"
    organizer -> tourneyhub.spa.organizerUi "starts a new season"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "POST season with the current number"
    tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "locks the league, compares the number"
    tourneyhub.api.leaguesApi -> tourneyhub.db.tournaments "no unfinished tournament (BR-010): 422 with their ids"
    alt {
      when "the number is current" {
        tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "closes it, starts the next with a copy of the table"
        tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "201: the new season"
      }
      when "stale or repeated" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "409 season_number_changed: reload"
      }
    }
  }

  dynamic view leaguePlayers {
    variant sequence
    title "17. Players of a league"
    order 22
    description "FR-012, BR-001, BR-002, BR-006 and ADR-002: names are unique in a league ignoring case, and a removed player keeps their name. Adding a removed player's name is refused with the holder, so the UI can ask whether it is the same person and restore that player. A league holds at most 1000 active players (BR-006). Removing and restoring send the target state."
    organizer -> tourneyhub.spa.organizerUi "adds a player"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "POST player"
    tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "locks the league, counts the active players (BR-006), looks up lower(name) among all players"
    alt {
      when "the name is free" {
        tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "inserts the player"
        tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "201: the player"
      }
      when "a player has it" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "422 player_name_taken: the holder and whether removed"
      }
    }
    organizer -> tourneyhub.spa.organizerUi "confirms it is the same person"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "PUT removed: false"
    tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "locks the league, clears removed_at"
    tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "200: the same player, history intact; 422 player_limit_reached over the limit"
    organizer -> tourneyhub.spa.organizerUi "renames a player, removed or not"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "PUT name"
    tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "locks the league, looks up lower(name) among the other players"
    alt {
      when "the name is free" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "200: the player with the new name"
      }
      when "another player has it" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "422 player_name_taken: the holder (409 if a write without the lock won the race)"
      }
    }
    organizer -> tourneyhub.spa.organizerUi "removes a player"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "GET the player's tournaments"
    tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "200: the unfinished tournaments the player is picked for; any of them blocks the removal (FR-012)"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "PUT removed: true"
    tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "locks the league, sets removed_at; the row and the name stay"
    tourneyhub.api.leaguesApi -> tourneyhub.db.tournaments "not picked for an unfinished tournament (BR-002): 422 with their ids"
  }

  dynamic view tournamentSetup {
    variant sequence
    title "18. Tournament setup"
    order 23
    description "FR-030 to FR-034, FR-038, ADR-008 and ADR-010: a tournament is created with a client id in the active season, takes the league's defaults, and is set up by target states. Every write locks the league, then the tournament. A change to the picks draws again with the engine and increments the draw counter; draw again carries the counter the screen showed."
    organizer -> tourneyhub.spa.organizerUi "new tournament: DYP, round robin"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST tournament with a client id"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "locks the league, finds the active season"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "a known id: the same one back or 409; else a new one with the league's defaults, its phase, fields and seed"
    organizer -> tourneyhub.spa.organizerUi "picks 13 players"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT the picked players"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament; a removed player: 409"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "league ranking, halves (one left out by lot), partners, seeds"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "picks, halves, pairs and seeds; draw counter + 1"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "the setup with the draw counter"
    organizer -> tourneyhub.spa.organizerUi "draw again"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST draw with the expected counter"
    alt {
      when "the counter is current" {
        tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "partners from the next counter's lot; with ranking halves and an odd count, the left-out player is drawn again too"
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the new pairs"
      }
      when "stale or repeated" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "409 draw_counter_changed: reload"
      }
    }
    organizer -> tourneyhub.spa.organizerUi "moves a pair up"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT the full seed order; not the current entries: 409"
    organizer -> tourneyhub.spa.organizerUi "deletes a tournament after confirming"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "DELETE; a closed season: 409, a repeat: 404"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "everything under it by cascade; the players stay"
  }

  dynamic view tournamentStart {
    variant sequence
    title "19. Generate and start, back to setup"
    order 23
    description "FR-031, FR-035, FR-036, BR-040 to BR-044, BR-050 to BR-052, BR-130, ADR-008 and ADR-010: the review screen reads the preview first, which runs the same checks and the same round robin or bracket without writing and returns the draw counter and the seed order. Starting carries both, since a hand reordering of the seeds leaves the counter. The engine makes the round robin, or for a knockout without a group phase the bracket, from the setup seeds and fills the fields; the schedule is stored in one transaction. Back to setup deletes the schedule or the bracket while no match in the tournament has a result (FR-036, BR-096) and keeps the draws. A round robin and a knockout without a group phase are generated so far."
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "GET setup/preview"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "same checks and round robin or bracket as the start, nothing written"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: rounds and counts (a bracket: its first round, byes and size), or the reason it cannot start; the draw counter and the seed order"
    organizer -> tourneyhub.spa.organizerUi "Generate and start"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST start with the expected draw counter and seed order"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "locks the league"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the tournament: started 409, stale counter 409"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "setup complete? pairs, halves, FR-032 minimum (4 with a third-place match), at most 16 entries in a round robin (FR-032; the code still stops at 64) or 256 in a knockout: else 422"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "seeds in the order the review showed? else 409 seed_order_changed"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "round robin by seed: circle method, one sit-out per round with an odd count; or the bracket by seed: byes for the top seeds, seeds 1 and 2 apart"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "rounds, matches, sides with their players, participation: bulk inserts; a bracket stores every match, sides only in round 1"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "free fields take the first matches whose players are free"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "fields hold their matches; state in_progress"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the whole tournament with the waiting list"
    organizer -> tourneyhub.spa.organizerUi "Back to setup"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST back-to-setup expecting in_progress"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament"
    alt {
      when "no match has a result (BR-096)" {
        tourneyhub.api.tournamentsApi -> tourneyhub.db.play "frees the fields, deletes the rounds; entries, seeds and draws stay"
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the tournament in setup"
      }
      when "some match has a result (BR-096)" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "422 tournament_has_results"
      }
      when "not in progress (a repeat)" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "409 tournament_not_in_progress: reload"
      }
    }
  }

  dynamic view roundRobinFinish {
    variant sequence
    title "20. Standings, finishing a round robin and the season standings"
    order 24
    description "FR-040, FR-060, BR-070, BR-071, BR-101, BR-103, BR-110, BR-111 and ADR-009: the play read computes the waiting list and the round robin's standings from the stored results; a sit-out is counted once its round is played and earns no points in a round robin (BR-071: only Swiss and Monster DYP score it). When every match has a result, the organizer confirms in the UI and finishes. The places and season points are computed on read, from the standings and the season's placement points table; nothing derived is stored. The season standings sum the points of the season's finished tournaments on read (BR-112, BR-113). A knockout after the round robin is view 22, and its places feed the season standings the same way."
    organizer -> tourneyhub.spa.organizerUi "opens the schedule or the Standings tab"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "GET …/play"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "loads the rounds, results, games and participation"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "waiting order with the busy fields; standings: points, head-to-head of two level entries, game difference, score difference, shared places"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: waiting, standings, group_done"
    organizer -> tourneyhub.spa.organizerUi "group phase done: Finish the tournament now, confirms"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST …/finish expecting in_progress"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "locks the league"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the tournament: not in progress 409; a knockout or another format 422"
    alt {
      when "every match has a result" {
        tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "state finished"
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the tournament"
      }
      when "a match without a result" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "422 group_phase_not_done with matches_left"
      }
    }
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "GET …/places"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "the season's placement points table"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "standings to places, places to points per player, shared places split and rounded down"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: places with points per player"
    tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "GET …/seasons/{season_id}/standings, then …/tournaments/{tournament_id}/season-effect"
    tourneyhub.api.leaguesApi -> tourneyhub.db.play "the season's finished tournaments with their rounds and results"
    tourneyhub.api.leaguesApi -> tourneyhub.api.engine "places per tournament, points summed per player (BR-112), ranked by points then wins, level players share the place (BR-113); the effect compares with and without the tournament"
    tourneyhub.spa.organizerUi <- tourneyhub.api.leaguesApi "200: season standings; the effect is empty until the tournament is finished"
  }

  dynamic view fieldsDuringPlay {
    variant sequence
    title "21. Fields during play"
    order 25
    description "FR-090 to FR-094, BR-130 to BR-134 and ADR-008: the organizer adds and removes fields and places matches by hand while the tournament runs. Each write locks the league, then the tournament, and sends a target state: a new field carries the number it expects, a field is removed by its id, a placement names each match with its field or with none (a swap names both). The engine refuses a player on two fields; the freed fields take the next waiting match, except one the request sent back to waiting: that match is held (BR-133, BR-136), stays in the waiting list marked held and takes no field by itself until it is placed again, released or has a result. The waiting list is computed on read."
    organizer -> tourneyhub.spa.organizerUi "Manage fields: Add a field"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST …/fields with the expected number, the lowest free one"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "locks the league"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the tournament: not in progress 409; another number 409 field_number_changed"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "the new field takes the first waiting match whose players are free"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "201: the field and its match"
    organizer -> tourneyhub.spa.organizerUi "moves a match, swaps two fields or sends one back to waiting"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/fields/placements: each match with its field, or none"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament, with its rounds and fields"
    alt {
      when "a stale screen" {
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "409 match_has_result or field_not_free: reload"
      }
      when "a player on two fields (BR-131)" {
        tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "places by hand, checks every player"
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "422 player_on_another_field"
      }
      when "otherwise" {
        tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "places by hand; the freed fields take the next waiting matches, not the held ones sent back (BR-133)"
        tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "fields hold their new matches; a match placed by hand stays until its result"
        tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the tournament with its fields and waiting list"
      }
    }
    organizer -> tourneyhub.spa.organizerUi "releases a held match"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/fields/placements: the match waiting, not held"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament; a match not held now is 409 placement_changed"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "clears held_at; the match keeps its place in schedule order (BR-136)"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "free fields are filled as after any write: the released match can take one if it is the first that can be played"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the tournament with its fields and waiting list"
    organizer -> tourneyhub.spa.organizerUi "removes a field after confirming"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "DELETE …/fields/{id}; a repeat 404, the last field 422"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "its match goes to the front of the waiting list (requeued_at)"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "the field goes, the others keep their numbers; free fields are filled"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "204"
  }

  dynamic view knockoutAfterRoundRobin {
    variant sequence
    title "22. Knockout after a round robin, a Swiss or Monster DYP rounds"
    order 26
    description "FR-037, FR-045, FR-046, FR-054, BR-040 to BR-044, BR-053, BR-074, BR-080, BR-085, BR-087, BR-094, BR-102, BR-103, BR-120, ADR-008 and DATA-MODEL D4: the preview shows the cut, the seeds and the byes; the start carries the phase the screen saw as current. Knockout entries continue the qualifiers or are pairs of two qualifying players after Monster DYP rounds, every bracket match of a fixed-pair knockout is created, and only the first round stores its sides; later sides are derived from the winners on every read. A Lord have mercy knockout stores round 1 and each later round when it is drawn, with a replacement for each disabled player still in when one is available (BR-140 to BR-149, BR-153 to BR-155). After Monster DYP rounds the organizer picks a mode and in the lot modes (A little mercy, Lord have mercy) the pairs are drawn by lot with the draw counter (ADR-010); the start carries the expected counter. The final's own format can change while the final has no result. A result is locked while a later match it feeds has one; the last result finishes the tournament. Deleting the knockout by its phase id unlocks the round robin, or the newest round of a Swiss or Monster DYP (BR-087)."
    organizer -> tourneyhub.spa.organizerUi "group phase done: Draw the knockout, picks the number, the third-place match and the formats"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "GET …/knockout/preview"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "standings, the cut with the lot knockout-seeding for a tie, byes for the top seeds"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: seeds, first round, bracket size, or the start's problem"
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/knockout expecting the group phase as current and the draw counter"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament: another current phase 409; a stale draw counter 409; no mode or matches left 422"
    tourneyhub.api.tournamentsApi -> tourneyhub.db.play "the knockout phase, its entries, every match, the first round's sides; free fields take the playable matches"
    tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the tournament"
    opt "draw again" {
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST …/knockout/draw expecting the draw counter"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament: a stale counter 409 draw_counter_changed; increments the counter"
      tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the new draw counter; the screen reads the preview again"
    }
    opt "the organizer changes the final's format" {
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/knockout/final-format, null for the knockout's format"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament: a final with a result 409 match_has_result; stores the phase's final_match_format"
      tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "200: the tournament"
    }
    loop "the semifinals, the final and the third-place match" {
      organizer -> tourneyhub.spa.organizerUi "enters a result on the bracket"
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "PUT …/matches/{id}/result"
      tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "derives the sides: other entries than the screen saw 409 match_sides_changed; a later match with a result locks this one (422 result_locked)"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.play "the result; a match whose side is no longer known leaves its field; the last result finishes the tournament"
    }
    tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "GET …/bracket and …/places"
    tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "knockout places first, the rest in group order, season points"
    opt "the organizer deletes the knockout" {
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "DELETE …/phases/{phase_id}; a repeat 404"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.play "the knockout's matches and entries go; the round robin unlocks"
      tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "204"
    }
    opt "Lord have mercy" {
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "GET …/knockout/rounds instead of …/bracket (that answers 422 format_not_supported): the rounds, the players and next_draw, the replacements the draw would make"
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "POST …/knockout/rounds expecting the round number"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the league, then the tournament: a stale number 409; a match without a result 422 round_not_complete"
      tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "plans the replacements from the disabled players and the group standing, then draws by lot"
      tourneyhub.api.tournamentsApi -> tourneyhub.db.play "stores the round with each replacement on their side-player row; the winners of the round before are locked (422 round_locked)"
      tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "DELETE …/knockout/rounds/{round_id}; only the newest, round 1 deletes the knockout; its replacements are undone"
      tourneyhub.spa.organizerUi <- tourneyhub.api.tournamentsApi "201 for the draw, 200 for the read: the knockout round by round; 204 for the delete"
    }
  }
}
