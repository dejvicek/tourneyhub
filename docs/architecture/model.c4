// Logical model of TourneyHub, following ADR.md (main) and DATA-MODEL.md (PR #3).
// Short `summary` goes on the node, the long `description` into the details panel.
model {

  organizer = actor "Organizer" {
    description "Creates leagues, runs tournament evenings on a phone and enters results. The only kind of user with an account."
    link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#2-users "PRD §2 Users"
    link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#51-a-dyp-evening "PRD §5.1 A DYP evening"
  }
  viewer = actor "Player or viewer" {
    description "No account. Follows the schedule, the bracket and the standings through the share link; changes nothing."
    link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#68-sharing "PRD §6.8 Sharing (FR-070 to FR-072)"
  }
  admin = actor "Instance admin" {
    description "Runs the VPS, sets the sign-up code and resets forgotten passwords. An ordinary account with the is_admin flag."
    link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-007--instance-admin-admin-flag-admin-screens-cli-bootstrap "ADR-007"
    link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#61-accounts "PRD §6.1 Accounts (FR-005, FR-006)"
  }
  developer = actor "Developer" {
    description "Martin and dejvicek. Code and documents change only through a reviewed PR with passing checks."
    link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-012--quality-gates-in-github-actions "ADR-012"
  }

  tourneyhub = system "TourneyHub" {
    #proposed
    summary "Leagues and tournaments for game nights: Singles, Doubles, DYP and Monster DYP, season standings and a share link for viewers."
    description "
      Leagues and tournaments for game nights (board games, foosball, racket sports, e-sports): Singles, Doubles, DYP and Monster DYP, season standings and a share link for viewers.
      One instance for groups the owner knows. All ADRs are still Proposed (orange stripe).
    "
    link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md "PRD"
    link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md "ADR"

    spa = webapp "Web application (SPA)" {
      technology "React 19, Vite, TypeScript, Tailwind, shadcn/ui, React Router, TanStack Query, react-i18next"
      icon tech:react
      summary "Mobile-first, English and Czech. Every screen works on a phone; entering a result takes three taps."
      description "
        Mobile-first, English and Czech. Every screen works on a phone; entering a result takes at most three taps (FR-082).
        Runs in the user's browser; served by Vite (development) or Caddy (production), and /api goes through the same origin.
      "
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-003--frontend-react-vite-typescript-tailwind-shadcnui "ADR-003"
      link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#69-language-and-devices "PRD §6.9 Language and devices (FR-080 to FR-082)"

      organizerUi = component "Organizer screens" {
        description "Leagues, players, seasons, tournament setup, draws, rounds, results and the knockout."
        link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#64-tournaments "PRD §6.4 Tournaments"
      }
      adminUi = component "Admin screens" {
        description "Sign-up code, list of organizers, password reset. The server checks every action against is_admin in the database."
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-007--instance-admin-admin-flag-admin-screens-cli-bootstrap "ADR-007"
      }
      publicUi = component "Viewer pages" {
        description "League, seasons, schedule, bracket and standings through the share token. Tournaments still in setup are not shown."
        link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#68-sharing "PRD §6.8 Sharing"
      }
      authClient = component "Client-side auth" {
        technology "Bearer JWT in memory, refresh cookie"
        summary "Access token in memory only. Refresh on page load and after 401, at most one in flight per tab."
        description "
          Keeps the access token in memory only and sends it as Authorization: Bearer. The refresh token is an HttpOnly cookie that the browser sends only to /api/v1/auth.
          Refreshes on page load and after 401, with at most one refresh in flight per tab; requests that get 401 meanwhile wait for it and are retried once.
          On 403 password_change_required it opens the new-password screen; a 403 never triggers a refresh.
        "
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-006--authentication-jwt-access-token-and-rotating-refresh-token "ADR-006"
      }
      apiTypes = component "API types" {
        technology "openapi-typescript"
        icon tech:typescript-icon
        description "Used by the whole frontend. Generated at build time from the committed openapi.json; no hand-written API types."
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-008--api-conventions-and-generated-client-types "ADR-008"
      }

      organizerUi -> authClient "needs the access token"
      adminUi -> authClient "needs the access token"
    }

    api = container "API" {
      technology "Python 3.13, FastAPI on uvicorn, Pydantic v2, SQLAlchemy 2 (synchronous), psycopg 3, Alembic migrations"
      icon tech:python
      summary "REST under /api/v1. Errors always {code, detail}. League writes lock the league, then the tournament."
      description "
        REST under /api/v1, OpenAPI schema committed in backend/openapi.json. Errors always as {code, detail}; the frontend builds the user-facing text.
        Every write in a league locks the league first, then the tournament (SELECT … FOR UPDATE); unsafe operations carry the state they expect and get 409 on a mismatch.
        Endpoints are plain def functions; FastAPI runs them in its thread pool. Alembic migrations run when the container starts.
      "
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-001--backend-python-fastapi-sqlalchemy-alembic "ADR-001"
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-008--api-conventions-and-generated-client-types "ADR-008"

      authApi = component "API: auth" {
        technology "JWT HS256, Argon2id"
        summary "/api/v1/auth: sign-up, login, refresh with rotation and a 60-second window, logout, password change."
        description "
          /api/v1/auth: sign-up with the sign-up code, login, refresh with rotation and a 60-second window, logout, password change.
          Abuse limits slow responses down with growing delays instead of locking the account; counters live in PostgreSQL (auth_attempts). The IP from X-Forwarded-For is trusted only from Caddy.
          is_admin and must_change_password are read from the users row on every request, not from the token.
        "
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-006--authentication-jwt-access-token-and-rotating-refresh-token "ADR-006"
        link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#61-accounts "PRD §6.1 Accounts (FR-001 to FR-004)"
      }
      adminApi = component "API: instance admin" {
        description "Sign-up code and password reset. A reset sets must_change_password and revokes all of the organizer's logins. Every action is recorded in admin_actions."
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-007--instance-admin-admin-flag-admin-screens-cli-bootstrap "ADR-007"
        link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#61-accounts "PRD §6.1 Accounts (FR-005, FR-006)"
      }
      leaguesApi = component "API: leagues, players, seasons" {
        summary "Create a league with Season 1, settings, player list, new season, closed seasons read-only (FR-010 to FR-022)."
        description "FR-010 to FR-022. Starting a new season carries the current season's number, otherwise 409. The client sends the new league's id (UUIDv7)."
        link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#62-leagues-and-players "PRD §6.2 and §6.3"
      }
      tournamentsApi = component "API: tournaments" {
        summary "Setup, draws, generating, rounds, results, knockout, late players, disabling."
        description "
          Setup, draws, generating, rounds, results, knockout, late players, disabling.
          A round is deleted by its id, adding a round carries the expected round_no, “shuffle again” carries the expected draw counter; a mismatch returns 409 and the client reloads the state.
        "
        link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#64-tournaments "PRD §6.4 to §6.7"
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-008--api-conventions-and-generated-client-types "ADR-008"
      }
      publicApi = component "API: viewers" {
        description "/api/v1/public/{share_token}: read-only, no login. The share token has at least 128 bits of randomness."
        link https://github.com/dejvicek/tourneyhub/blob/main/PRD.md#68-sharing "PRD §6.8 Sharing (FR-070 to FR-072)"
      }
      engine = component "Engine" {
        technology "tourneyhub.engine, pure functions"
        summary "Bracket, schedule, Swiss, Monster DYP, standings, places, season points and lots. Touches no database, clock or network."
        description "
          Bracket, schedule, Swiss, Monster DYP, standings with BH1 and BH2, places, season points and lots from the tournament's seed (SHA-256).
          Pure functions: no database, clock or network, so it is tested with Hypothesis. Derived data is never stored; it is computed on every read.
        "
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-009--tournament-engine-as-pure-functions-derived-data-computed-on-read "ADR-009"
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-010--lots-stored-seed-and-sha-256-ordering "ADR-010"
        link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-011--pairing-when-a-repeat-cannot-be-avoided "ADR-011"
        style {
          color green
        }
      }
    }

    cli = tool "tourneyhub CLI" {
      technology "Python, runs in the api container"
      icon tech:python
      description "create-admin, grant-admin, revoke-admin. No web route can create an admin, so a stranger cannot claim the instance on first start."
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-007--instance-admin-admin-flag-admin-screens-cli-bootstrap "ADR-007"
    }

    db = database "PostgreSQL 17" {
      technology "builtin locale C.UTF-8"
      icon tech:postgresql
      description "Only source data is stored; standings, places and season points are computed on every read. The same version in development and production."
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-002--database-postgresql "ADR-002"
      link https://github.com/dejvicek/tourneyhub/blob/docs/data-model-mvp/DATA-MODEL.md "DATA-MODEL.md (PR #3)"

      accounts = tableGroup "Accounts and administration" {
        description "users, refresh_tokens, auth_attempts, instance_settings, admin_actions"
        link https://github.com/dejvicek/tourneyhub/blob/docs/data-model-mvp/DATA-MODEL.md#41-accounts-and-administration "DATA-MODEL §4.1"
      }
      leagues = tableGroup "Leagues, players and seasons" {
        description "leagues, players, seasons (with the placement points table)"
        link https://github.com/dejvicek/tourneyhub/blob/docs/data-model-mvp/DATA-MODEL.md#42-leagues-players-and-seasons "DATA-MODEL §4.2"
      }
      tournaments = tableGroup "Tournaments and entries" {
        description "tournaments, tournament_phases, entries, entry_members, dyp_halves"
        link https://github.com/dejvicek/tourneyhub/blob/docs/data-model-mvp/DATA-MODEL.md#43-tournaments-and-phases "DATA-MODEL §4.3"
        link https://github.com/dejvicek/tourneyhub/blob/docs/data-model-mvp/DATA-MODEL.md#44-entries "DATA-MODEL §4.4"
      }
      play = tableGroup "Rounds and matches" {
        description "rounds, round_participation, matches, match_sides, match_side_players"
        link https://github.com/dejvicek/tourneyhub/blob/docs/data-model-mvp/DATA-MODEL.md#45-rounds-matches-and-results "DATA-MODEL §4.5"
      }

      leagues -[fk]-> accounts "league owner (owner_user_id)"
      tournaments -[fk]-> leagues "tournament's season (season_id), players (player_id)"
      play -[fk]-> tournaments "phase (phase_id), entries (entry_id)"
      play -[fk]-> leagues "players on match sides (player_id)"
    }
  }

  github = externalSystem "GitHub" {
    technology "GitHub Free, private repository"
    icon tech:github
    description "Private repository on the Free plan; checks are required by agreement (no branch protection for private repositories on Free)."
    link https://github.com/dejvicek/tourneyhub "dejvicek/tourneyhub"

    repo = externalComponent "Repository" {
      technology "git, reviewed PRs"
      icon tech:git
      description "Code, PRD, ADR and data model. Changes reach main only through a reviewed PR."
      link https://github.com/dejvicek/tourneyhub "dejvicek/tourneyhub"
    }
    actions = externalComponent "GitHub Actions" {
      technology "workflow with checks, ci-ok"
      icon tech:github-actions
      summary "ruff, mypy, pytest with Hypothesis, Vitest, Playwright against the production images. Free: 2,000 minutes a month."
      description "
        Checks from ADR-012: ruff, mypy, pytest with Hypothesis, Vitest, openapi.json drift check and more.
        Playwright runs against the production images (compose.prod.yaml): desktop Chromium on every PR, mobile emulation and WebKit before the pilot (ADR-013).
        Free: 2,000 minutes a month and 500 MB of storage shared by artifacts and packages.
      "
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-012--quality-gates-in-github-actions "ADR-012"
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-013--end-to-end-tests-and-checks-with-playwright "ADR-013"
    }
    ghcr = externalComponent "GHCR" {
      technology "GitHub Container Registry, api and web images"
      icon tech:docker
      description "Private api and web images; only the last few versions are kept. The VPS logs in with a token that can only read packages."
      link https://github.com/dejvicek/tourneyhub/blob/main/ADR.md#adr-014--deployment-images-in-ghcr-manual-pull-on-the-vps "ADR-014"
    }

    repo -> actions "runs the checks on PRs and after merge"
    actions -> ghcr "pushes the tested images"
  }

  // Who uses what
  organizer -> tourneyhub.spa.organizerUi "manages leagues, runs the evening, enters results"
  viewer -> tourneyhub.spa.publicUi "opens the share link"
  admin -> tourneyhub.spa.adminUi "sets the sign-up code, resets a password"
  admin -> tourneyhub.cli "creates the first admin (create-admin)"
  admin -> github.ghcr "pulls new images on the VPS"
  developer -> github.repo "PRs and reviews"

  // SPA to API (through Caddy in production)
  tourneyhub.spa.authClient -> tourneyhub.api.authApi "sign-up, login, refresh (cookie), logout, password change"
  tourneyhub.spa.organizerUi -> tourneyhub.api.leaguesApi "Bearer JWT"
  tourneyhub.spa.organizerUi -> tourneyhub.api.tournamentsApi "Bearer JWT"
  tourneyhub.spa.adminUi -> tourneyhub.api.adminApi "Bearer JWT"
  tourneyhub.spa.publicUi -> tourneyhub.api.publicApi "anonymously"

  // API to engine and database
  tourneyhub.api.authApi -> tourneyhub.db.accounts "passwords, refresh tokens, login attempts"
  tourneyhub.api.adminApi -> tourneyhub.db.accounts "password reset, action record"
  tourneyhub.api.leaguesApi -> tourneyhub.db.leagues "reads and writes"
  tourneyhub.api.leaguesApi -> tourneyhub.db.tournaments "tournament states before a new season (BR-010)"
  tourneyhub.api.leaguesApi -> tourneyhub.db.play "results for season standings and the league ranking"
  tourneyhub.api.tournamentsApi -> tourneyhub.db.leagues "locks the league (FOR UPDATE)"
  tourneyhub.api.tournamentsApi -> tourneyhub.db.tournaments "locks the tournament, setup and draws"
  tourneyhub.api.tournamentsApi -> tourneyhub.db.play "rounds, matches, results"
  tourneyhub.api.publicApi -> tourneyhub.db.leagues "finds the league by share token"
  tourneyhub.api.publicApi -> tourneyhub.db.tournaments "tournaments past setup"
  tourneyhub.api.publicApi -> tourneyhub.db.play "rounds and results"
  tourneyhub.api.tournamentsApi -> tourneyhub.api.engine "draws, pairs, computes standings"
  tourneyhub.api.leaguesApi -> tourneyhub.api.engine "season standings, league ranking"
  tourneyhub.api.publicApi -> tourneyhub.api.engine "computes standings on read"
  tourneyhub.cli -> tourneyhub.db.accounts "writes the admin and the action record"
}
