<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Infrastructure layer: EF Core (PostgreSQL), Redis, email, payment providers.
    Depends on Application (NFR-001). Implements the ports declared in Application.
  -->
  <PropertyGroup>
    <RootNamespace>TourneyHub.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TourneyHub.Application\TourneyHub.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.0" />
  </ItemGroup>
</Project>
