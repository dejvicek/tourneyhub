  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "openapi-typescript": "^7.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.1.1"
  },
  "overrides": {
