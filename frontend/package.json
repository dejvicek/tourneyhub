{
  "name": "tourneyhub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../backend/openapi.json --output src/api/schema.d.ts",
    "dev": "pnpm run generate:api && vite",
    "build": "pnpm run generate:api && tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run generate:api && tsc --build --noEmit . e2e",
    "lint": "pnpm run generate:api && eslint --max-warnings=0 . && i18next-cli lint",
    "format": "pnpm run generate:api && eslint --fix . && prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run generate:api && vitest run",
    "e2e": "playwright test --config e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.0.1",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "i18next-cli": "^1.87.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
