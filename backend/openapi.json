{
  "components": {
    "schemas": {
      "AccessTokenRead": {
        "description": "An access token for `Authorization: Bearer`, valid 15 minutes (ADR-006).\n\nThe SPA keeps it in memory only; the refresh token comes as a cookie.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "AccessTokenRead",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Every stable error code of the API (ADR-008).",
        "enum": [
          "validation_failed",
          "not_found",
          "method_not_allowed",
          "bad_request",
          "internal_error",
          "token_expired",
          "not_authenticated",
          "password_change_required",
          "forbidden",
          "too_many_attempts",
          "league_not_found",
          "league_id_taken",
          "league_name_changed",
          "league_not_active"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "The body of every error response (ADR-008).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Detail",
            "type": "object"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JsonValue": {},
      "LeagueCreate": {
        "additionalProperties": false,
        "description": "A new league; `id` is generated by the client (ADR-008).",
        "properties": {
          "id": {
            "format": "uuid7",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/LeagueName"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "LeagueCreate",
        "type": "object"
      },
      "LeagueName": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "LeagueRead": {
        "description": "A league as the organizer sees it.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "title": "LeagueRead",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "An email and a password; `throttle_login` reads it too (ADR-006).",
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Log in with email and password and start a login on this device.\n\nA wrong password and an unknown email get the same 401. After repeated\nfailures, an attempt within a growing waiting period gets 429 with\n`Retry-After`; nothing is locked.",
        "operationId": "log_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt is checked.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Log In",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "End this device's login and remove the cookie; repeating it is harmless.",
        "operationId": "log_out",
        "parameters": [
          {
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "maxLength": 64,
              "title": "X-Requested-With",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "refresh_token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Log Out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Exchange the refresh cookie for a new access token and a new cookie.\n\nA 401 means: log in again.",
        "operationId": "refresh",
        "parameters": [
          {
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "maxLength": 64,
              "title": "X-Requested-With",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "refresh_token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/leagues": {
      "post": {
        "description": "Create a league, or return it again when the request is repeated.\n\nAn id of another organizer's league, or a repeat racing its first attempt,\nis 409: reload.",
        "operationId": "create_league",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeagueCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create League",
        "tags": [
          "leagues"
        ]
      }
    },
    "/api/v1/leagues/{league_id}": {
      "get": {
        "description": "Return one of the organizer's leagues; another organizer's is 404.",
        "operationId": "read_league",
        "parameters": [
          {
            "in": "path",
            "name": "league_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "League Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read League",
        "tags": [
          "leagues"
        ]
      }
    }
  }
}
