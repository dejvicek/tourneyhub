{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Every stable error code of the API (ADR-008).",
        "enum": [
          "validation_failed",
          "not_found",
          "method_not_allowed",
          "bad_request",
          "internal_error",
          "token_expired",
          "not_authenticated",
          "password_change_required",
          "forbidden",
          "league_not_found",
          "league_id_taken",
          "league_name_taken",
          "league_name_changed",
          "league_not_active"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "The body of every error response (ADR-008).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Detail",
            "type": "object"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JsonValue": {},
      "LeagueCreate": {
        "additionalProperties": false,
        "description": "A new league; `id` is generated by the client (ADR-008).",
        "properties": {
          "id": {
            "format": "uuid7",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/LeagueName"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "LeagueCreate",
        "type": "object"
      },
      "LeagueName": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "LeagueRead": {
        "description": "A league as the organizer sees it.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/LeagueStatus"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "LeagueRead",
        "type": "object"
      },
      "LeagueStatus": {
        "description": "Where a league is in its life (DATA-MODEL \u00a74.2).",
        "enum": [
          "active",
          "archived"
        ],
        "title": "LeagueStatus",
        "type": "string"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "An email and a password; `throttle_login` reads it too (ADR-006).",
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResult": {
        "description": "The account that logged in.",
        "properties": {
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "LoginResult",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Log in. Repeated failures make the answer slower; nothing is locked.",
        "operationId": "log_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Log In",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/leagues": {
      "post": {
        "description": "Create a league, or return it again when the request is repeated.\n\nA name the organizer already uses is 422 `league_name_taken`. An id of\nanother organizer's league, or a request racing another, is 409: reload.",
        "operationId": "create_league",
        "parameters": [
          {
            "in": "header",
            "name": "x-user-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeagueCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Create League",
        "tags": [
          "leagues"
        ]
      }
    },
    "/api/v1/leagues/{league_id}": {
      "get": {
        "description": "Return one of the organizer's leagues; another organizer's is 404.",
        "operationId": "read_league",
        "parameters": [
          {
            "in": "path",
            "name": "league_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "League Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-user-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Read League",
        "tags": [
          "leagues"
        ]
      }
    }
  }
}
