{
  "components": {
    "schemas": {
      "AccessTokenRead": {
        "description": "An access token for `Authorization: Bearer`, valid 15 minutes (ADR-006).\n\nThe SPA keeps it in memory only; the refresh token comes as a cookie.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "AccessTokenRead",
        "type": "object"
      },
      "DefaultMatchFormat": {
        "description": "The match format a league's new tournaments start with (FR-011, BR-120).\n\nNot BO2: only group phases of leagues with draws can play it (BR-121), so a\ndefault that a knockout cannot take is never copied (DATA-MODEL \u00a74.2).",
        "enum": [
          "bo1",
          "bo3",
          "bo5"
        ],
        "title": "DefaultMatchFormat",
        "type": "string"
      },
      "DisplayName": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "Email": {
        "maxLength": 320,
        "pattern": "^[^@\\s]+@[^@\\s.]+(\\.[^@\\s.]+)+$",
        "type": "string"
      },
      "ErrorCode": {
        "description": "Every stable error code of the API (ADR-008).",
        "enum": [
          "validation_failed",
          "not_found",
          "method_not_allowed",
          "bad_request",
          "internal_error",
          "token_expired",
          "not_authenticated",
          "password_change_required",
          "forbidden",
          "too_many_attempts",
          "invalid_signup_code",
          "email_taken",
          "wrong_password",
          "password_unchanged",
          "league_not_found",
          "league_id_taken",
          "season_not_found",
          "season_closed",
          "season_number_changed"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "The body of every error response (ADR-008).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Detail",
            "type": "object"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JsonValue": {},
      "Language": {
        "description": "The UI language an account remembers (FR-081, DATA-MODEL \u00a74.1).",
        "enum": [
          "en",
          "cs"
        ],
        "title": "Language",
        "type": "string"
      },
      "LeagueCreate": {
        "additionalProperties": false,
        "description": "A new league; `id` is generated by the client (ADR-008).",
        "properties": {
          "id": {
            "format": "uuid7",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/LeagueName"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "LeagueCreate",
        "type": "object"
      },
      "LeagueName": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "LeagueRead": {
        "description": "A league as its organizer sees it, with every season, oldest first.\n\n`share_token` is the secret of the league's share link (FR-070, FR-071).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "default_field_count": {
            "title": "Default Field Count",
            "type": "integer"
          },
          "default_goals_per_game": {
            "title": "Default Goals Per Game",
            "type": "integer"
          },
          "default_match_format": {
            "$ref": "#/components/schemas/DefaultMatchFormat"
          },
          "draws_allowed": {
            "title": "Draws Allowed",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "seasons": {
            "items": {
              "$ref": "#/components/schemas/SeasonRead"
            },
            "title": "Seasons",
            "type": "array"
          },
          "share_token": {
            "title": "Share Token",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "name",
          "draws_allowed",
          "default_field_count",
          "default_match_format",
          "default_goals_per_game",
          "share_token",
          "created_at",
          "updated_at",
          "seasons"
        ],
        "title": "LeagueRead",
        "type": "object"
      },
      "LeagueSummary": {
        "description": "A league in the organizer's list (FR-007).",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "LeagueSummary",
        "type": "object"
      },
      "LeagueUpdate": {
        "additionalProperties": false,
        "description": "League settings to change (FR-011); a field left out or null stays as it is.\n\nEach value is the target state, so repeating the request changes nothing\n(ADR-008). The placement points table belongs to the season: see\n`set_placement_points`.",
        "properties": {
          "default_field_count": {
            "anyOf": [
              {
                "maximum": 32.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Field Count"
          },
          "default_goals_per_game": {
            "anyOf": [
              {
                "maximum": 99.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Goals Per Game"
          },
          "default_match_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DefaultMatchFormat"
              },
              {
                "type": "null"
              }
            ]
          },
          "draws_allowed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draws Allowed"
          },
          "name": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LeagueName"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "LeagueUpdate",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "An email and a password; `throttle_login` reads it too (ADR-006).",
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "NewPassword": {
        "format": "password",
        "maxLength": 1024,
        "minLength": 15,
        "type": "string",
        "writeOnly": true
      },
      "PasswordChange": {
        "additionalProperties": false,
        "description": "The current password and the new one (FR-004).",
        "properties": {
          "current_password": {
            "format": "password",
            "maxLength": 1024,
            "title": "Current Password",
            "type": "string",
            "writeOnly": true
          },
          "new_password": {
            "$ref": "#/components/schemas/NewPassword"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange",
        "type": "object"
      },
      "PlacementPoints": {
        "items": {
          "maximum": 2147483647.0,
          "minimum": 0.0,
          "type": "integer"
        },
        "maxItems": 256,
        "minItems": 1,
        "type": "array"
      },
      "PlacementPointsUpdate": {
        "additionalProperties": false,
        "description": "The whole placement points table, first place first (FR-011).",
        "properties": {
          "placement_points": {
            "$ref": "#/components/schemas/PlacementPoints"
          }
        },
        "required": [
          "placement_points"
        ],
        "title": "PlacementPointsUpdate",
        "type": "object"
      },
      "ProfileUpdate": {
        "additionalProperties": false,
        "description": "The fields to change; a field left out or null stays as it is.",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DisplayName"
              },
              {
                "type": "null"
              }
            ]
          },
          "language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ProfileUpdate",
        "type": "object"
      },
      "SeasonName": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "SeasonRead": {
        "description": "A season; `name` is null while it has the default name (FR-020).",
        "properties": {
          "closed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "placement_points": {
            "items": {
              "type": "integer"
            },
            "title": "Placement Points",
            "type": "array"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SeasonState"
          }
        },
        "required": [
          "id",
          "number",
          "name",
          "state",
          "placement_points",
          "started_at",
          "closed_at"
        ],
        "title": "SeasonRead",
        "type": "object"
      },
      "SeasonRename": {
        "additionalProperties": false,
        "description": "A season's new name; null restores the default \"Season <number>\" (FR-020).",
        "properties": {
          "name": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SeasonName"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name"
        ],
        "title": "SeasonRename",
        "type": "object"
      },
      "SeasonStart": {
        "additionalProperties": false,
        "description": "Start the next season; the active season's number as the client saw it.",
        "properties": {
          "expected_current_number": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Expected Current Number",
            "type": "integer"
          }
        },
        "required": [
          "expected_current_number"
        ],
        "title": "SeasonStart",
        "type": "object"
      },
      "SeasonState": {
        "description": "Whether a season is the league's active one (FR-021, DATA-MODEL \u00a74.2).",
        "enum": [
          "active",
          "closed"
        ],
        "title": "SeasonState",
        "type": "string"
      },
      "SignUpRequest": {
        "additionalProperties": false,
        "description": "A new account and the instance's sign-up code (FR-001); the throttle reads it.",
        "properties": {
          "display_name": {
            "$ref": "#/components/schemas/DisplayName"
          },
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "language": {
            "$ref": "#/components/schemas/Language",
            "default": "en"
          },
          "password": {
            "$ref": "#/components/schemas/NewPassword"
          },
          "signup_code": {
            "format": "password",
            "maxLength": 256,
            "title": "Signup Code",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "signup_code",
          "email",
          "display_name",
          "password"
        ],
        "title": "SignUpRequest",
        "type": "object"
      },
      "UserRead": {
        "description": "The caller's account.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_admin": {
            "title": "Is Admin",
            "type": "boolean"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "language",
          "is_admin",
          "must_change_password"
        ],
        "title": "UserRead",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Log in with email and password and start a login on this device.\n\nA wrong password and an unknown email get the same 401. After repeated\nfailures, an attempt within a growing waiting period gets 429 with\n`Retry-After`; nothing is locked.",
        "operationId": "log_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt is checked.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Log In",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "End this device's login and remove the cookie; repeating it is harmless.",
        "operationId": "log_out",
        "parameters": [
          {
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "maxLength": 64,
              "title": "X-Requested-With",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "refresh_token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Log Out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "description": "Change the password and log out every other device (FR-004, ADR-006).\n\nWorks while an admin reset requires a new password, and then ends that\nrequirement. The login this call came from stays. 422 `wrong_password` is a\nwrong current password; 422 `password_unchanged` a new one equal to it. The\ncurrent password is checked on the login's budget: after repeated failures,\nhere or at login, an attempt within a growing waiting period gets 429 with\n`Retry-After`.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt is checked.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Exchange the refresh cookie for a new access token and a new cookie.\n\nA 401 means: log in again.",
        "operationId": "refresh",
        "parameters": [
          {
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "maxLength": 64,
              "title": "X-Requested-With",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "refresh_token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "description": "Create an organizer's account with the instance's sign-up code, logged in.\n\n422 `invalid_signup_code` means a wrong code or closed sign-up; 422\n`email_taken` an email that has an account, in any letter case. After\nrepeated failures an attempt within a growing waiting period gets 429 with\n`Retry-After`. The tokens are those of a login.",
        "operationId": "sign_up",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt is checked.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Sign Up",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/leagues": {
      "get": {
        "description": "List the organizer's own leagues, oldest first (FR-007).",
        "operationId": "list_leagues",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LeagueSummary"
                  },
                  "title": "Response List Leagues",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Leagues",
        "tags": [
          "leagues"
        ]
      },
      "post": {
        "description": "Create a league with its Season 1, or return it again on a repeat (FR-010).\n\nAn id of another organizer's league, or a repeat racing its first attempt,\nis 409: reload.",
        "operationId": "create_league",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeagueCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
