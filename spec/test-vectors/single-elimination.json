      "realMatchCount": 2,
      "rounds": [
        {
          "round": 1,
          "name": "Semifinals",
          "matches": [
            { "id": "R1M1", "slot": 1, "a": 1, "b": "BYE", "walkover": true, "advances": 1 },
            { "id": "R1M2", "slot": 2, "a": 2, "b": 3 }
          ]
        },
        {
          "round": 2,
          "name": "Final",
