{
  "$comment": "Golden oracle for deterministic single-elimination bracket generation (FR-047, FR-048, FR-053, BR-101, NFR-018). Seeds are 1-based (1 = top seed). Non-power-of-two fields pad up to the next power of two; phantom seeds (> N) become byes assigned to the TOP seeds. Legend for match sides a/b: integer = seed; 'BYE' = automatic walkover; 'W(<matchId>)' = winner of a prior match.",
  "seedingConvention": {
    "description": "Standard recursive bracket seeding. Slot order for size 2^k is built by expanding each seed s in a size-n bracket into the pair (s, n+1-s).",
    "slotOrders": {
      "2": [1, 2],
      "4": [1, 4, 2, 3],
      "8": [1, 8, 4, 5, 2, 7, 3, 6],
      "16": [1, 16, 8, 9, 4, 13, 5, 12, 2, 15, 7, 10, 3, 14, 6, 11]
    }
  },
  "invariants": [
    "realMatchCount == participants - 1",
    "bracketSize == smallest power of two >= participants",
    "byeCount == bracketSize - participants",
    "byes are assigned to the byeCount lowest-numbered (top) seeds",
    "no match has BYE on both sides",
    "seed 1 and seed 2 can only meet in the final (opposite halves)",
    "thirdPlaceMatch is optional (config, E-27) and excluded from realMatchCount"
  ],
