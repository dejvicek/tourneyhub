{
  "$comment": "Golden oracle for money math (BR-005, BR-008, FR-072, FR-074, FR-075a, FR-081). ALL amounts are integer MINOR units (e.g. cents). Never use double/float. Two distinct mechanisms: (1) prize distribution across ranks, (2) team payout split among members.",
  "rules": {
    "prizePool": "prizePool = sum(paid entry fees) - organizerFee (BR-005, FR-072). Organizer fee is EITHER a percentage OR a fixed amount, never both (BR-006, FR-074).",
    "rankDistribution": "share_i = round(prizePool * pct_i) using banker's rounding (round-half-to-even) to integer minor units; then reconcile any residual so that sum(shares) == prizePool by assigning the leftover minor unit(s) to the TOP rank(s) first (BR-008).",
    "teamSplit": "For teamSize > 1, split a Payout equally among members: base = floor(amount / teamSize) to every member; the remainder (amount - base*teamSize) goes ENTIRELY to the captain (FR-075a). For teamSize == 1, a single PayoutShare equals the whole amount.",
    "invariants": [
      "sum(rank shares) == prizePool exactly",
      "sum(PayoutShares) == payout amount exactly",
      "no share is negative",
      "single currency per financial scope (BR-007, FR-080)"
    ]
  },
