# The configuration of the e2e job's production stack (ci.yml, ADR-013).
# Dummy values for a throwaway stack on the CI runner; not secrets.
POSTGRES_PASSWORD=ci-not-a-secret
TOURNEYHUB_DATABASE_URL=postgresql+psycopg://postgres:ci-not-a-secret@db:5432/tourneyhub
TOURNEYHUB_JWT_SECRET=ci-not-a-secret-0123456789abcdef0123456789abcdef
# compose.prod.yaml fixes TOURNEYHUB_ENV=production and
# TOURNEYHUB_COOKIE_SECURE=true.
# The ports the Playwright config expects (frontend/e2e/playwright.config.ts).
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=localhost
